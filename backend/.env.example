APP_ENV=development
AUTH_MODE=disabled
DATABASE_URL=postgresql+psycopg://agent_zero:agent_zero_local@localhost:5433/agent_zero
REDIS_URL=redis://localhost:16379/0
OBJECT_STORAGE_ENDPOINT=http://localhost:8333
OBJECT_STORAGE_BUCKET=agent-zero
OBJECT_STORAGE_ACCESS_KEY=agentzero
OBJECT_STORAGE_SECRET_KEY=local-development-only
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_SECURE=false
LOG_LEVEL=INFO
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
