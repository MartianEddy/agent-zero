MAX_RETRIEVED_DOCUMENT_CHARS=60000
MAX_MATCHING_REGIONS_PER_CLAIM=4
MAX_SOURCE_CHARS_PER_SOURCE=6000
MAX_TOTAL_EVIDENCE_CHARS=24000
MAX_EVIDENCE_WINDOWS_PER_SOURCE_PER_CLAIM=2
MAX_IMAGES_TO_MODEL=4
MAX_MODEL_OUTPUT_TOKENS_RESEARCH=700
MAX_MODEL_OUTPUT_TOKENS_SYNTHESIS=900
MAX_PROVIDER_RETRIES=1
CLICKCAST_API_TOKEN=
CLICKCAST_IDENTITY_KEY=
CLICKCAST_OWNER_ID=
